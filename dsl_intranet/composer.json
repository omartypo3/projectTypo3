{
    "name": "dsl-factory/dsl-intranet",
    "type": "typo3-cms-extension",
    "description": "Intranet.",
    "version": "1.0.0",
    "require": {
        "typo3/cms-core": "^11.5"
    },
    "require-dev": {
        "typo3/testing-framework": "^6.9.0"
    },
    "autoload": {
        "psr-4": {
            "DslFactory\\DslIntranet\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DslFactory\\DslIntranet\\Tests\\": "Tests"
        }
    },
    "replace": {
        "typo3-ter/dsl-intranet": "self.version"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin"
    },
    "scripts": {
        "post-autoload-dump": [
            "TYPO3\\TestingFramework\\Composer\\ExtensionTestEnvironment::prepare"
        ]
    },
    "extra": {
        "typo3/cms": {
            "web-dir": ".Build/Web",
            "extension-key": "dsl_intranet"
        }
    }
}