									<numIndex index="3" type="array">
										<numIndex index="0">LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_general.catAndOr.2</numIndex>
										<numIndex index="1">2</numIndex>
									</numIndex>
									<numIndex index="4" type="array">
										<numIndex index="0">LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_general.catAndOr.3</numIndex>
										<numIndex index="1">3</numIndex>
									</numIndex>
								</items>
							</config>
					</settings.filtre.categories.andOr>
