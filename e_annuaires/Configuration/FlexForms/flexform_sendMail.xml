					<settings.orderBy>
							<label>LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_general.orderBy</label>
							<config>
								<type>select</type>
								 <renderType>selectSingle</renderType>
								<items>
									<numIndex index="0" type="array">
										<numIndex index="0"></numIndex>
										<numIndex index="1"></numIndex>
									</numIndex>
									<numIndex index="1">
										<numIndex index="0">LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_general.orderBy.tstamp</numIndex>
										<numIndex index="1">tstamp</numIndex>
									</numIndex>
									<numIndex index="2">
										<numIndex index="0">LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_general.orderBy.sorting</numIndex>
										<numIndex index="1">sorting</numIndex>
									</numIndex>
									<numIndex index="3">
										<numIndex index="0">LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_general.orderBy.crdate</numIndex>
										<numIndex index="1">crdate</numIndex>
									</numIndex>
									<numIndex index="4">
										<numIndex index="0">LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_general.orderBy.title</numIndex>
										<numIndex index="1">title</numIndex>
									</numIndex>
								</items>
								<itemsProcFunc>Emagineurs\EAnnuaires\Hooks\ItemsProcFunc->user_addSortingFields</itemsProcFunc>
							</config>
					</settings.orderBy>
					<settings.ordre>
							<label>LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_additional.ordre</label>
							<config>
								<type>select</type>
								 <renderType>selectSingle</renderType>
								<items type="array">
									<numIndex index="0" type="array">
										<numIndex index="0">LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_additional.ordre.asc</numIndex>
										<numIndex index="1">ASC</numIndex>
									</numIndex>
									<numIndex index="1" type="array">
										<numIndex index="0">LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_additional.ordre.desc</numIndex>
										<numIndex index="1">DESC</numIndex>
									</numIndex>
								</items>
								<maxitems>1</maxitems>
								<size>1</size>
							</config>
					</settings.ordre>
					<!-- Activer filtre de date -->
                    <settings.filterDate.activate>
                            
                            <onChange>reload</onChange> 
                            <label>LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_additional.filterDate.activate</label>
                            <config>
                                <type>check</type>
                            </config>
                    </settings.filterDate.activate>
                    <!-- Filtre de date -->
                    <settings.filterDate.slider>
                            <displayCond>FIELD:settings.filterDate.activate:=:1</displayCond>
                            <label>LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_additional.filterDate.slider</label>
                            <config>
                                <type>input</type>
                                <size>2</size>
                                <default>10</default>
                                <eval>int</eval>
                                <range>
                                    <lower>1</lower>
                                    <upper>50</upper>
                                </range>
                                <fieldControl>
                                    <slider>
                                        <disabled>false</disabled>
                                    </slider>
                                </fieldControl>
                            </config>
                    </settings.filterDate.slider>
                    <settings.filterDate.range>
                             <displayCond>FIELD:settings.filterDate.activate:=:1</displayCond>
                            <label>LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_additional.filterDate.range</label>
                            <config>
                                <type>select</type>
								<renderType>selectSingle</renderType>
                                <items type="array">
                                    <numIndex index="2" type="array">
                                        <numIndex index="0">LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_additional.filterDate.range.days</numIndex>
                                        <numIndex index="1">day</numIndex>
                                    </numIndex>
                                    <numIndex index="3" type="array">
                                        <numIndex index="0">LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_additional.filterDate.range.weeks</numIndex>
                                        <numIndex index="1">week</numIndex>
                                    </numIndex>
                                    <numIndex index="4" type="array">
                                        <numIndex index="0">LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_additional.filterDate.range.months</numIndex>
                                        <numIndex index="1">month</numIndex>
                                    </numIndex>
                                    <numIndex index="5" type="array">
                                        <numIndex index="0">LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_additional.filterDate.range.years</numIndex>
                                        <numIndex index="1">year</numIndex>
                                    </numIndex>
                                </items>
                            </config>
                    </settings.filterDate.range>
