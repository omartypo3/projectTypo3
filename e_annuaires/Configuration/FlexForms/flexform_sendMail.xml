			<ROOT>
				<sheetTitle>LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_tab.additional</sheetTitle>
				<type>array</type>
				<el>
					<!-- PID Single Page -->
					<settings.detailPid>
							<label>LLL:EXT:e_annuaires/Resources/Private/Language/locallang_be.xlf:flexforms_additional.detailPid</label>
							<config>
								<type>group</type>
								<internal_type>db</internal_type>
								<allowed>pages</allowed>
								<size>1</size>
								<maxitems>1</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
								<fieldControl>
									<addRecord>
										<disabled>false</disabled>
