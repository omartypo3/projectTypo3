<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <general>
            <ROOT>
                <sheetTitle>LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.general</sheetTitle>
                <type>array</type>
                <el>
                    <settings.storagePid>
                        <label>LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.storagePid</label>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>pages</allowed>
                            <size>5</size>
                            <maxitems>9999</maxitems>
                            <minitems>0</minitems>
                            <show_thumbs>1</show_thumbs>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                    <default>
                                        <searchWholePhrase>1</searchWholePhrase>
                                    </default>
                                </suggest>
                            </wizards>
                        </config>
                    </settings.storagePid>
                    <settings.formFieldDisplay>
                        <label>LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.formFieldDisplay</label>
                        <config>
                            <type>check</type>
                            <items type="array">
                                <numIndex index="1" type="array">
                                    <numIndex index="0">LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.formFieldDisplay.title</numIndex>
                                    <numIndex index="1">title</numIndex>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <numIndex index="0">LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.formFieldDisplay.email</numIndex>
                                    <numIndex index="1">email</numIndex>
                                </numIndex>
                                <numIndex index="3" type="array">
                                    <numIndex index="0">LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.formFieldDisplay.name</numIndex>
                                    <numIndex index="1">name</numIndex>
                                </numIndex>
                                <numIndex index="4" type="array">
                                    <numIndex index="0">LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.formFieldDisplay.firstname</numIndex>
                                    <numIndex index="1">firstname</numIndex>
                                </numIndex>
                                <numIndex index="5" type="array">
                                    <numIndex index="0">LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.formFieldDisplay.category</numIndex>
                                    <numIndex index="1">category</numIndex>
                                </numIndex>
                                <numIndex index="6" type="array">
                                    <numIndex index="0">LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.formFieldDisplay.replyForm</numIndex>
                                    <numIndex index="1">replyForm</numIndex>
                                </numIndex>
                                <numIndex index="7" type="array">
                                    <numIndex index="0">LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.formFieldDisplay.file</numIndex>
                                    <numIndex index="1">file</numIndex>
                                </numIndex>
                            </items>
                            <default>27</default>
                        </config>
                    </settings.formFieldDisplay>
                    <settings.maxFileSize>
                        <label>LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.maxFileSize</label>
                        <config>
                            <type>input</type>
                            <size>255</size>
                            <eval>int</eval>
                            <default>0</default>
                        </config>
                    </settings.maxFileSize>
                    <settings.overwriteValidationModeratorEmail>
                        <label>LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.overwriteValidationModeratorEmail</label>
                        <config>
                            <type>input</type>
                            <size>255</size>
                            <eval>trim</eval>
                        </config>
                    </settings.overwriteValidationModeratorEmail>
                </el>
            </ROOT>
        </general>
        <filter>
            <ROOT>
                <sheetTitle>LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.search</sheetTitle>
                <type>array</type>
                <el>
                    <settings.hideIfNoParam>
                        <label>LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.hideIfNoParam</label>
                        <config>
                            <type>check</type>
                        </config>
                    </settings.hideIfNoParam>
                    <settings.categories>
                        <label>LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.categories</label>
                        <config>
                            <type>category</type>
                            <relationship>oneToMany</relationship>
                            <foreign_table>sys_category</foreign_table>
                            <foreign_table_where>AND (sys_category.sys_language_uid = 0 OR sys_category.l10n_parent = 0) ORDER BY sys_category.sorting</foreign_table_where>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                            <size>10</size>
                            <treeConfig>
                                <parentField>parent</parentField>
                                <appearance>
                                    <expandAll>1</expandAll>
                                    <showHeader>1</showHeader>
                                </appearance>
                            </treeConfig>
                        </config>
                    </settings.categories>
                    <settings.orderDirection>
                        <label>LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.orderDirection</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="1">
                                    <numIndex index="0">LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.orderDirection.asc</numIndex>
                                    <numIndex index="1">asc</numIndex>
                                </numIndex>
                                <numIndex index="2">
                                    <numIndex index="0">LLL:EXT:e_comment/Resources/Private/Language/locallang_db.xlf:tx_ecomment.orderDirection.desc</numIndex>
                                    <numIndex index="1">desc</numIndex>
                                </numIndex>
                            </items>
                            <default>desc</default>
                        </config>
                    </settings.orderDirection>
                </el>
            </ROOT>
        </filter>
    </sheets>
</T3DataStructure>
