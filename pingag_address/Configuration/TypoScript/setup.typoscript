plugin.tx_pingagaddress_mapshow {
    view {
        templateRootPaths.0 = EXT:pingag_address/Resources/Private/Templates/
        templateRootPaths.1 = {$plugin.tx_pingagaddress_mapshow.view.templateRootPath}
        partialRootPaths.0 = EXT:pingag_address/Resources/Private/Partials/
        partialRootPaths.1 = {$plugin.tx_pingagaddress_mapshow.view.partialRootPath}
        layoutRootPaths.0 = EXT:pingag_address/Resources/Private/Layouts/
        layoutRootPaths.1 = {$plugin.tx_pingagaddress_mapshow.view.layoutRootPath}
    }
    persistence {
        storagePid = {$plugin.tx_pingagaddress_mapshow.persistence.storagePid}
        #recursive = 1
    }
    features {
        #skipDefaultArguments = 1
        # if set to 1, the enable fields are ignored in BE context
        ignoreAllEnableFieldsInBe = 0
    }
    mvc {
        #callDefaultActionIfActionCantBeResolved = 1
    }
    settings{
        pageconfirmUid = 228
        FrontendUserGroup = 3
        PidNewUser = 1048
        PidFolderNewUser = 1048
        PidFolderPassword = 1056
    }
}

# these classes are only used in auto-generated templates
plugin.tx_pingagaddress._CSS_DEFAULT_STYLE (
    textarea.f3-form-error {
        background-color:#FF9F9F;
        border: 1px #FF0000 solid;
    }

    input.f3-form-error {
        background-color:#FF9F9F;
        border: 1px #FF0000 solid;
    }

    .tx-pingag-address table {
        border-collapse:separate;
        border-spacing:10px;
    }

    .tx-pingag-address table th {
        font-weight:bold;
    }

    .tx-pingag-address table td {
        vertical-align:top;
    }

    .typo3-messages .message-error {
        color:red;
    }

    .typo3-messages .message-ok {
        color:green;
    }
)
page {

    includeJSFooter {
         jquery = https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js
         jquery.disableCompression = 1
         map = EXT:pingag_address/Resources/Public/Js/map.js
         map.disableCompression = 1
         filter = EXT:pingag_address/Resources/Public/Js/filter_map.js
         filter.disableCompression = 1
         suchenKurse = EXT:pingag_address/Resources/Public/Js/suchenKurse.js
         suchenKurse.disableCompression = 1
         filterAdress = EXT:pingag_address/Resources/Public/Js/filterAdress.js
         filterAdress.disableCompression = 1
    }
}

ajaxCallLocations = PAGE
ajaxCallLocations {
  typeNum = 1995
  10 < tt_content.list.20.pingagaddress_mapshow

  config {
    disableAllHeaderCode = 1
    xhtml_cleaning = 0
    admPanel = 0
    debug = 0
    no_cache = 1
  }
}

ajaxAdressComunication = PAGE
ajaxAdressComunication {
  typeNum = 1996
  10 < tt_content.list.20.pingagaddress_addresscommunication

  config {
    disableAllHeaderCode = 1
    xhtml_cleaning = 0
    admPanel = 0
    debug = 0
    no_cache = 1
  }
}

ajaxList = PAGE
ajaxList {
    typeNum = 2000
    10 < tt_content.list.20.sfeventmgt_pieventlist

     config {
            disableAllHeaderCode = 1
            xhtml_cleaning = 0
            admPanel = 0
            debug = 0
            no_cache = 1
     }
}


ajaxCallProduct = PAGE
ajaxCallProduct {
    typeNum = 2022

    config {
        disableAllHeaderCode = 1
        xhtml_cleaning = 1
        admPanel = 0
        additionalHeaders = Content-type: text/plain
        no_cache = 1
    }

    10 = USER
    10 {
        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
        pluginName = Products
        extensionName = CartProducts
        controller = Product
        vendorName = Extcode
        action = list

        switchableControllerActions {
            Product {
                1 = list
            }
        }

        persistence =< plugin.tx_cartproducts.persistence
        view =< plugin.tx_cartproducts.view
        update =< plugin.tx_cartproducts.update
        settings < plugin.tx_cartproducts.settings
    }

}