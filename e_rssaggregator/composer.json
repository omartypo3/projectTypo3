	"description": "Affichage d'une liste d'un ou plusieurs flux, aggrégés.",
	"type": "typo3-cms-extension",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"typo3",
		"extension",
		"rss",
		"aggregator"
	],
	"authors": [
		{
			"name": "Ian SEBBAGH, Costa \"Coco\" C.",
			"email": "isebbagh@e-magineurs.com",
			"homepage": "https://www.e-magineurs.com",
			"role": "Developer"
		}
	],
	"require": {
        "php": ">=8.1",
		"typo3/cms-core": "^13.0"
	},
	"autoload": {
		"psr-4": {
			"Emagineurs\\ERssaggregator\\": "Classes/"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "e_rssaggregator"
		}
	}
}

