{
  "name": "emagineurs/e_import_export",
  "type": "typo3-cms-extension",
  "description": "Import or export within different formats",
  "keywords": [
    "TYPO3",
    "extension",
    "e_import_export"
  ],
  "homepage": "http://www.e-magineurs.com/",
  "authors": [
    {
      "name": "Ian Sebbach",
      "role": "Developer",
      "homepage": "http://www.e-magineurs.com/"
    }
  ],
  "license": [
    "GPL-2.0+"
  ],
  "require": {
    "php": ">=8.1",
    "typo3/cms-core": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Emagineurs\\EImportExport\\": "Classes/"
    }
  },
  "replace": {
    "e_import_export": "self.version",
    "typo3-ter/e_import_export": "self.version"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "e_import_export"
    }
  }
}
