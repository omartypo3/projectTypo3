{
	"name": "emagineurs/e-social-feed",
	"description": "Extension permettant la remontée d'infos depuis les réseaux sociaux facebook, instagram et twitter",
	"type": "typo3-cms-extension",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"typo3",
		"extension",
		"social",
		"feed"
	],
	"authors": [
		{
			"name": "Xavier Ley",
			"email": "xley@e-magineurs.com",
			"homepage": "https://www.e-magineurs.com",
			"role": "Developer"
		}
	],
	"require": {
        "php": ">=8.1",
		"typo3/cms-core": "^13.0"
	},
	"autoload": {
		"psr-4": {
			"Emagineurs\\ESocialFeed\\": "Classes/"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "e_social_feed"
		}
	}
}

