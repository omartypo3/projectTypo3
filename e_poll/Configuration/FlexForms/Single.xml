<T3DataStructure>
	<meta>
		<langDisable>1</langDisable>
	</meta>
	<sheets>
		<general>
			<ROOT>
				<sheetTitle>LLL:EXT:e_poll/Resources/Private/Language/locallang_db.xml:tx_epoll.general</sheetTitle>
				<type>array</type>
				<el>
					<settings.singlePoll>
						<label>LLL:EXT:e_poll/Resources/Private/Language/locallang_db.xml:tx_epoll.singlePoll</label>
						<config>
							<type>group</type>
							<allowed>tx_epoll_domain_model_poll</allowed>
							<size>1</size>
							<maxitems>1</maxitems>
							<minitems>0</minitems>
						</config>
					</settings.singlePoll>

					<settings.storagePid>
						<label>LLL:EXT:e_poll/Resources/Private/Language/locallang_db.xml:tx_epoll.storagePid</label>
						<config>
							<type>group</type>
							<allowed>pages</allowed>
							<size>5</size>
							<maxitems>9999</maxitems>
							<minitems>0</minitems>
						</config>
					</settings.storagePid>

					<settings.verificationType>
						<label>LLL:EXT:e_poll/Resources/Private/Language/locallang_db.xml:tx_epoll.verificationType</label>
						<config>
							<type>select</type>
							<renderType>selectSingle</renderType>
							<items>
								<numIndex index="0">
									<label>LLL:EXT:e_poll/Resources/Private/Language/locallang_db.xml:tx_epoll.verificationType.cookie</label>
									<value>cookie</value>
								</numIndex>
								<numIndex index="1">
									<label>LLL:EXT:e_poll/Resources/Private/Language/locallang_db.xml:tx_epoll.verificationType.ip</label>
									<value>ip</value>
								</numIndex>
							</items>
							<default>cookie</default>
						</config>
					</settings.verificationType>

					<settings.verificationPeriod>
						<label>LLL:EXT:e_poll/Resources/Private/Language/locallang_db.xml:tx_epoll.verificationPeriod</label>
						<config>
							<type>number</type>
							<size>5</size>
						</config>
					</settings.verificationPeriod>

					<settings.categories>
						<label>LLL:EXT:e_poll/Resources/Private/Language/locallang_db.xml:tx_epoll.categories</label>
						<config>
							<type>select</type>
							<renderType>selectTree</renderType>
							<foreign_table>sys_category</foreign_table>
							<foreign_table_where> AND sys_category.sys_language_uid IN (-1, 0) ORDER BY sys_category.title ASC</foreign_table_where>
							<maxitems>9999</maxitems>
							<size>10</size>
							<treeConfig>
								<parentField>parent</parentField>
								<appearance>
									<expandAll>1</expandAll>
									<showHeader>1</showHeader>
								</appearance>
							</treeConfig>
						</config>
					</settings.categories>
				</el>
			</ROOT>
		</general>
	</sheets>
</T3DataStructure>
