{
    "name": "stratis/stratis-elements",
    "type": "typo3-cms-extension",
    "description": "TYPO3 Extension for Stratis Elements",
    "license": "GPL-2.0-or-later",
    "require": {
        "typo3/cms-core": "^13.4",
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Stratis\\StratisElements\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "stratis_elements"
        }
    },
    "replace": {
        "typo3-ter/stratis_elements": "self.version"
    }
}
