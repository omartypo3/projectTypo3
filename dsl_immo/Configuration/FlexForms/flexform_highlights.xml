<T3DataStructure>
	<sheets>
		
		<!--
					################################
					  SHEET Additional
					################################
				-->
		<additional>
			<ROOT>
				<TCEforms>
					<sheetTitle>Einstellungen</sheetTitle>
				</TCEforms>
				<type>array</type>
				<el>


					<!-- PID Single Page -->
					<settings.detailPid>
						<TCEforms>
							<label>Seite für Einzelansicht</label>
							<config>
								<type>group</type>
								<internal_type>db</internal_type>
								<allowed>pages</allowed>
								<size>1</size>
								<maxitems>1</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
								<wizards>
									<suggest>
										<type>suggest</type>
										<default>
											<searchWholePhrase>1</searchWholePhrase>
										</default>
									</suggest>
								</wizards>
							</config>
						</TCEforms>
					</settings.detailPid>

					<!-- PID Single Page -->
					<settings.listPid>
						<TCEforms>
							<label>Seite mit Listenansicht</label>
							<config>
								<type>group</type>
								<internal_type>db</internal_type>
								<allowed>pages</allowed>
								<size>1</size>
								<maxitems>1</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
								<wizards>
									<suggest>
										<type>suggest</type>
										<default>
											<searchWholePhrase>1</searchWholePhrase>
										</default>
									</suggest>
								</wizards>
							</config>
						</TCEforms>
					</settings.listPid>
					
					
					<settings.limit>
						<TCEforms>
							<label>Maximale Anzahl</label>
							<config>
								<type>input</type>
								<size>5</size>
								<eval>int,required</eval>
							</config>
						</TCEforms>
					</settings.limit>
					
					<settings.vermarktung>
						<TCEforms>
							<label>Vermarktung</label>
							<config>
								<type>select</type>
								  <items type="array">
									<numIndex index="0" type="array">
									  <numIndex index="0">Mieten</numIndex>
									  <numIndex index="1">s1010</numIndex>
									</numIndex>
									<numIndex index="1" type="array">
									  <numIndex index="0">Kaufen</numIndex>
									  <numIndex index="1">s1020</numIndex>
									</numIndex>
									
								  </items>
								  <maxitems>10</maxitems>
								  <size>3</size>
							</config>
						</TCEforms>
					</settings.vermarktung>
					<settings.objekttyp>
						<TCEforms>
							<label>ObjektTyp</label>
							<config>
								<type>select</type>
								  <items type="array">
									<numIndex index="0" type="array">
									  <numIndex index="0">Wohnung</numIndex>
									  <numIndex index="1">s1010</numIndex>
									</numIndex>
									<numIndex index="1" type="array">
									  <numIndex index="0">Haus</numIndex>
									  <numIndex index="1">s1020</numIndex>
									</numIndex>
									<numIndex index="2" type="array">
									  <numIndex index="0">Grundstück</numIndex>
									  <numIndex index="1">s1030</numIndex>
									</numIndex>
									<numIndex index="3" type="array">
									  <numIndex index="0">Gewerbe/Büro</numIndex>
									  <numIndex index="1">s1040</numIndex>
									</numIndex>
									<numIndex index="4" type="array">
									  <numIndex index="0">Garage/Stellplatz</numIndex>
									  <numIndex index="1">s1050</numIndex>
									</numIndex>
									<numIndex index="5" type="array">
									  <numIndex index="0">Anlage</numIndex>
									  <numIndex index="1">s1060</numIndex>
									</numIndex>
									
								  </items>
								  <maxitems>10</maxitems>
								  <size>3</size>
							</config>
						</TCEforms>
					</settings.objekttyp>
					
				
					
				</el>
			</ROOT>
		</additional>
		
		
	</sheets>
</T3DataStructure>