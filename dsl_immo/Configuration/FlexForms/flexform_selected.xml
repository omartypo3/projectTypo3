<T3DataStructure>
	<sheets>
		
		<!--
					################################
					  SHEET Additional
					################################
				-->
		<additional>
			<ROOT>
				<TCEforms>
					<sheetTitle>Einstellungen</sheetTitle>
				</TCEforms>
				<type>array</type>
				<el>


					<!-- PID Single Page -->
					<settings.detailPid>
						<TCEforms>
							<label>Seite für Einzelansicht</label>
							<config>
								<type>group</type>
								<internal_type>db</internal_type>
								<allowed>pages</allowed>
								<size>1</size>
								<maxitems>1</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
								<wizards>
									<suggest>
										<type>suggest</type>
										<default>
											<searchWholePhrase>1</searchWholePhrase>
										</default>
									</suggest>
								</wizards>
							</config>
						</TCEforms>
					</settings.detailPid>

					
					
					<settings.objekte>
						<TCEforms>
							<label>Externe Objektnummern getrennt mit einem Semikolon z.B. 1299/401;984-45</label>
							<config>
								<type>text</type>
								<cols>50</cols>
								<rows>3</rows>
							</config>
						</TCEforms>
					</settings.objekte>
					
					
					
				</el>
			</ROOT>
		</additional>
		
		
	</sheets>
</T3DataStructure>