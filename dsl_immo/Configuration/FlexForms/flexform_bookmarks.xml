<T3DataStructure>
	<sheets>
		
		<!--
					################################
					  SHEET Additional
					################################
				-->
		<additional>
			<ROOT>
				<TCEforms>
					<sheetTitle>Einstellungen</sheetTitle>
				</TCEforms>
				<type>array</type>
				<el>


					<!-- PID Single Page -->
					<settings.detailPid>
						<TCEforms>
							<label>Seite für Einzelansicht</label>
							<config>
								<type>group</type>
								<internal_type>db</internal_type>
								<allowed>pages</allowed>
								<size>1</size>
								<maxitems>1</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
								<wizards>
									<suggest>
										<type>suggest</type>
										<default>
											<searchWholePhrase>1</searchWholePhrase>
										</default>
									</suggest>
								</wizards>
							</config>
						</TCEforms>
					</settings.detailPid>

					<!-- PID Single Page -->
					<settings.listPid>
						<TCEforms>
							<label>Seite mit Listenansicht</label>
							<config>
								<type>group</type>
								<internal_type>db</internal_type>
								<allowed>pages</allowed>
								<size>1</size>
								<maxitems>1</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
								<wizards>
									<suggest>
										<type>suggest</type>
										<default>
											<searchWholePhrase>1</searchWholePhrase>
										</default>
									</suggest>
								</wizards>
							</config>
						</TCEforms>
					</settings.listPid>
					<settings.customTemplate>
						<TCEforms>
							<label>Benutzerdefiniertes Template abweichend vom Standard (z.B. Bookmarksfull.html)</label>
							<config>
								<type>input</type>
								<size>30</size>
								<max>100</max>
								<eval>trim</eval>
							</config>
						</TCEforms>
					</settings.customTemplate>

					
				</el>
			</ROOT>
		</additional>
		
		
	</sheets>
</T3DataStructure>