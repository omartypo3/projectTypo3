<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <general>
            <ROOT>
                <TCEforms>
                    <sheetTitle>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.general</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <switchableControllerActions>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.displayMode</label>
                            <onChange>reload</onChange>
                            <config>
                                <type>select</type>
                                <items type="array">
                                    <numIndex index="1" type="array">
                                        <numIndex index="0">LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.displayMode.list</numIndex>
                                        <numIndex index="1">Document->list;</numIndex>
                                    </numIndex>
                                    <numIndex index="2" type="array">
                                        <numIndex index="0">LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.displayMode.search</numIndex>
                                        <numIndex index="1">Document->search;</numIndex>
                                    </numIndex>
                                    <numIndex index="3" type="array">
                                        <numIndex index="0">LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.displayMode.listNew</numIndex>
                                        <numIndex index="1">Document->listNew;</numIndex>
                                    </numIndex>
                                    <numIndex index="4" type="array">
                                        <numIndex index="0">LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.displayMode.browse</numIndex>
                                        <numIndex index="1">Document->browse;</numIndex>
                                    </numIndex>
                                    <numIndex index="5" type="array">
                                        <numIndex index="0">LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.displayMode.listSelected</numIndex>
                                        <numIndex index="1">Document->listSelected;</numIndex>
                                    </numIndex>
                                </items>
                                <default>Document->list;</default>
                            </config>
                        </TCEforms>
                    </switchableControllerActions>

                    <settings.folder>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.folder</label>
                            <displayCond>
                                <OR>
                                    <numIndex index="0">FIELD:general.switchableControllerActions:=:Document->list;</numIndex>
                                    <numIndex index="1">FIELD:general.switchableControllerActions:=:Document->listNew;</numIndex>
                                    <numIndex index="2">FIELD:general.switchableControllerActions:=:Document->browse;</numIndex>
                                </OR>
                            </displayCond>
                            <config>
                                <type>group</type>
                                <internal_type>folder</internal_type>
                                <minitems>0</minitems>
                                <maxitems>1</maxitems>
                            </config>
                        </TCEforms>
                    </settings.folder>

                    <settings.syscollection>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.syscollection</label>
                            <displayCond>
                                <OR>
                                    <numIndex index="0">FIELD:general.switchableControllerActions:=:Document->list;</numIndex>
                                    <numIndex index="1">FIELD:general.switchableControllerActions:=:Document->listNew;</numIndex>
                                    <numIndex index="2">FIELD:general.switchableControllerActions:=:Document->browse;</numIndex>
                                </OR>
                            </displayCond>
                            <config>
                                <type>select</type>
                                <itemsProcFunc>Emagineurs\EGestiondocs\Hooks\ItemsProcFunc->user_getSysFileCollectiontList</itemsProcFunc>
                            </config>
                        </TCEforms>
                    </settings.syscollection>

                    <settings.files>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.files</label>
                            <displayCond>FIELD:general.switchableControllerActions:=:Document->listSelected;</displayCond>
                            <config>
                                <type>group</type>
                                <internal_type>file</internal_type>
                                <minitems>0</minitems>
                                <maxitems>100</maxitems>
                            </config>
                        </TCEforms>
                    </settings.files>

                    <settings.recursiveFind>                   
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.recursiveFind</label>
                            <displayCond>
                                <OR>
                                    <numIndex index="0">FIELD:general.switchableControllerActions:=:Document->list;</numIndex>
                                    <numIndex index="1">FIELD:general.switchableControllerActions:=:Document->listNew;</numIndex>
                                    <numIndex index="2">FIELD:general.switchableControllerActions:=:Document->browse;</numIndex>
                                </OR>
                            </displayCond>
                            <config>
                                <type>check</type>
                            </config>
                        </TCEforms>
                    </settings.recursiveFind>

                    <settings.limit>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.limit</label>
                            <displayCond>
                                <OR>
                                    <numIndex index="0">FIELD:general.switchableControllerActions:=:Document->list;</numIndex>
                                    <numIndex index="1">FIELD:general.switchableControllerActions:=:Document->listNew;</numIndex>
                                </OR>
                            </displayCond>
                            <config>
                                <type>input</type>
                                <size>5</size>
                                <eval>num</eval>
                            </config>
                        </TCEforms>
                    </settings.limit>

                    <settings.pagination>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.pagination</label>
                            <displayCond>
                                <OR>
                                    <numIndex index="0">FIELD:general.switchableControllerActions:=:Document->list;</numIndex>
                                    <numIndex index="1">FIELD:general.switchableControllerActions:=:Document->listNew;</numIndex>
                                    <numIndex index="3">FIELD:general.switchableControllerActions:=:Document->listSelected;</numIndex>
                                </OR>
                            </displayCond>
                            <config>
                                <type>check</type>
                            </config>
                        </TCEforms>
                    </settings.pagination>
                    
                    <settings.itemsPerPage>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.itemsPerPage</label>
                            <displayCond>
                                <OR>
                                    <numIndex index="0">FIELD:general.switchableControllerActions:=:Document->list;</numIndex>
                                    <numIndex index="1">FIELD:general.switchableControllerActions:=:Document->listNew;</numIndex>
                                    <numIndex index="3">FIELD:general.switchableControllerActions:=:Document->listSelected;</numIndex>
                                </OR>
                            </displayCond>
                            <config>
                                <type>input</type>
                                <size>5</size>
                                <eval>num</eval>
                            </config>
                        </TCEforms>
                    </settings.itemsPerPage>

                    <settings.displayFiles>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.displayFiles</label>
                            <displayCond>FIELD:general.switchableControllerActions:=:Document->browse;</displayCond>
                            <config>
                                <type>check</type>
                            </config>
                        </TCEforms>
                    </settings.displayFiles>

                    <settings.targetPid>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.targetPid</label>
                            <config>
                                <type>group</type>
                                <internal_type>db</internal_type>
                                <allowed>pages</allowed>
                                <size>1</size>
                                <maxitems>1</maxitems>
                                <minitems>0</minitems>
                                <show_thumbs>1</show_thumbs>
                                <wizards>
                                    <suggest>
                                        <type>suggest</type>
                                        <default>
                                            <searchWholePhrase>1</searchWholePhrase>
                                        </default>
                                    </suggest>
                                </wizards>
                            </config>
                        </TCEforms>
                    </settings.targetPid>
                </el>
            </ROOT>
        </general>

        <search>
            <ROOT>
                <TCEforms>
                    <sheetTitle>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.search</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.categories>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.categories</label>
                            <config>
                                <type>select</type>
                                <renderMode>tree</renderMode>
                                <treeConfig>
                                    <appearance>
                                        <expandAll>1</expandAll>
                                        <showHeader>1</showHeader>
                                    </appearance>
                                    <parentField>parent</parentField>
                                </treeConfig>
                                <foreign_table>sys_category</foreign_table>
                                <foreign_table_where>AND (sys_category.sys_language_uid = 0 OR sys_category.l10n_parent = 0) ORDER BY sys_category.sorting</foreign_table_where>
                                <size>10</size>
                                <autoSizeMax>20</autoSizeMax>
                                <minitems>0</minitems>
                                <maxitems>99</maxitems>
                            </config>
                        </TCEforms>
                    </settings.categories>

                    <settings.newPeriod>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.newPeriod</label>
                            <displayCond>
                                <OR>
                                    <numIndex index="0">FIELD:general.switchableControllerActions:=:Document->list;</numIndex>
                                    <numIndex index="1">FIELD:general.switchableControllerActions:=:Document->listNew;</numIndex>
                                </OR>
                            </displayCond>
                            <config>
                                <type>input</type>
                                <eval>int</eval>
                                <default>10</default>
                            </config>
                        </TCEforms>
                    </settings.newPeriod>

                    <settings.orderBy>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.orderBy</label>
                            <displayCond>
                                <OR>
                                    <numIndex index="0">FIELD:general.switchableControllerActions:=:Document->list;</numIndex>
                                    <numIndex index="1">FIELD:general.switchableControllerActions:=:Document->listNew;</numIndex>
                                    <numIndex index="2">FIELD:general.switchableControllerActions:=:Document->browse;</numIndex>
                                    <numIndex index="3">FIELD:general.switchableControllerActions:=:Document->listSelected;</numIndex>
                                </OR>
                            </displayCond>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items>
                                    <numIndex index="0" type="array">
                                        <numIndex index="0"></numIndex>
                                        <numIndex index="1"></numIndex>
                                    </numIndex>
                                    <numIndex index="1">
                                        <numIndex index="0">tstamp</numIndex>
                                        <numIndex index="1">tstamp</numIndex>
                                    </numIndex>
                                    <numIndex index="2">
                                        <numIndex index="0">datetime</numIndex>
                                        <numIndex index="1">datetime</numIndex>
                                    </numIndex>
                                    <numIndex index="3">
                                        <numIndex index="0">crdate</numIndex>
                                        <numIndex index="1">crdate</numIndex>
                                    </numIndex>
                                    <numIndex index="4">
                                        <numIndex index="0">title</numIndex>
                                        <numIndex index="1">title</numIndex>
                                    </numIndex>
                                </items>
                            </config>
                        </TCEforms>
                    </settings.orderBy>

                    <settings.orderDirection>
                        <TCEforms>
                            <label>LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.orderDirection</label>
                            <displayCond>
                                <OR>
                                    <numIndex index="0">FIELD:general.switchableControllerActions:=:Document->list;</numIndex>
                                    <numIndex index="1">FIELD:general.switchableControllerActions:=:Document->listNew;</numIndex>
                                    <numIndex index="2">FIELD:general.switchableControllerActions:=:Document->browse;</numIndex>
                                    <numIndex index="3">FIELD:general.switchableControllerActions:=:Document->listSelected;</numIndex>
                                </OR>
                            </displayCond>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items>
                                    <numIndex index="1">
                                        <numIndex index="0">LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.orderDirection.asc</numIndex>
                                        <numIndex index="1">asc</numIndex>
                                    </numIndex>
                                    <numIndex index="2">
                                        <numIndex index="0">LLL:EXT:e_gestiondocs/Resources/Private/Language/locallang_db.xml:tx_egestiondocs.orderDirection.desc</numIndex>
                                        <numIndex index="1">desc</numIndex>
                                    </numIndex>
                                </items>
                            </config>
                        </TCEforms>
                    </settings.orderDirection>
                </el>
            </ROOT>
        </search>
    </sheets>
</T3DataStructure>