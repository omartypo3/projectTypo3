$( '.btn-animate' ).hover(
  function() {
    $(this).addClass( "hover" );

    $(this).delay(400).queue( function(next){ 
        $(this).addClass( "hover2" );
        next();
  	});

  }, function() {
  	
	    $(this).removeClass( "hover" );
	    $(this).delay(400).queue( function(next){ 
	        $(this).removeClass( "hover2" );
	        next();
	  	});
  	
  }
);


