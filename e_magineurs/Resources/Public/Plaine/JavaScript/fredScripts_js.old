function menu_slide() {


windowWidth = $(window).width();

if( windowWidth >= 1500 )
{
    nbr_display= 4;
}
else if( windowWidth < 1500 && windowWidth >= 997)
{
    nbr_display= 3;
}

else if( windowWidth < 996 && windowWidth >= 661)
{
    nbr_display= 2;
}
else if( windowWidth < 660)
{
    nbr_display= 1;
}



nbr_element 	= $( "ul.menu_slide li" ).length;
Size_content 	= $( ".frame-type-menu_Sites" ).width();
Margin 			= 80;

nbr_margin 						= nbr_display-1;
W_marge_display					= nbr_margin*Margin;
width_total_img_without_margin	= Size_content-W_marge_display;
Width_element					= width_total_img_without_margin/nbr_display;

Total_width_element				= Width_element*nbr_element;

nbr_total_margin				= nbr_element-1;
Total_width_margin				= Margin*nbr_total_margin;
Width_contener					= Total_width_margin+Total_width_element;


$( "ul.menu_slide" ).css('width', Width_contener+'px');
$( "ul.menu_slide li" ).css('width', Width_element+'px');






//enlever le draggable slider si tout est déja affiché
nbr_position = nbr_element-nbr_display;
if (nbr_position <= 0){
	$("#block_draggable").css('display', 'none');
}
else{
	$("#block_draggable").css('display', 'block');
}


//==========
// $( ".case_draggable" ).on('click', function () {
//   	positionX = parseInt($(".case_draggable").css("left"));
// 	sizeW_block = parseInt($('#block_draggable').width())-parseInt($('.case_draggable').width());
// 	pourcent_position = positionX*100/sizeW_block*(-1);
	
// 	possible_width_move= Width_contener - Size_content;
// 	result_move= possible_width_move*pourcent_position/100;
// 	console.log(pourcent_position);
// 	$("ul.menu_slide").css('transform', 'translate('+result_move+'px)');
// });
http://touchpunch.furf.com/
$('.case_draggable').draggable({
  axis: 'x',
  containment: "#block_draggable",
  start: function( event, ui ) {
  		$("ul.menu_slide").delay(400).queue(function (next) { 
		    $("ul.menu_slide").css('transition', '');
		    next(); 
		});
  },

  drag: function( event, ui ) {

  		positionX = parseInt($(".case_draggable").css("left"));
   		sizeW_block = parseInt($('#block_draggable').width())-parseInt($('.case_draggable').width());
   		pourcent_position = positionX*100/sizeW_block*(-1);
   		
   		possible_width_move= Width_contener - Size_content;
   		result_move= possible_width_move*pourcent_position/100;
   		console.log(pourcent_position);
   		$("ul.menu_slide").css('transform', 'translate('+result_move+'px)');
  },

  stop: function( event, ui ) {

  		$("ul.menu_slide").css('transition', 'all ease-out 0.4s');
  		$("ul.menu_slide").delay(400).queue(function (next) { 
		    $("ul.menu_slide").css('transition', 'all ease-out 0.1s');
		    next();
		});
   		pourcent_position_plus=pourcent_position*(-1);
   		section= 100 / nbr_position;
   		sectionDiv2 = section/2;


   		function appel_section() {
   			section0 = sectionDiv2 + (0*section);
   			section1 = sectionDiv2 + (1*section);
   			section2 = sectionDiv2 + (2*section);
   			section3 = sectionDiv2 + (3*section);
   			section4 = sectionDiv2 + (4*section);
   			section5 = sectionDiv2 + (5*section);
   			section6 = sectionDiv2 + (6*section);
   			section7 = sectionDiv2 + (7*section);
   			section8 = sectionDiv2 + (8*section);
   			section9 = sectionDiv2 + (9*section);

   			pourcent_position_Fixe0 = 0*section*(-1);
   				result_move0= possible_width_move*pourcent_position_Fixe0/100;
   			pourcent_position_Fixe1 = 1*section*(-1);
   				result_move1= possible_width_move*pourcent_position_Fixe1/100;
   			pourcent_position_Fixe2 = 2*section*(-1);
   				result_move2= possible_width_move*pourcent_position_Fixe2/100;
   			pourcent_position_Fixe3 = 3*section*(-1);
   				result_move3= possible_width_move*pourcent_position_Fixe3/100;
   			pourcent_position_Fixe4 = 4*section*(-1);
   				result_move4= possible_width_move*pourcent_position_Fixe4/100;
   			pourcent_position_Fixe5 = 5*section*(-1);
   				result_move5= possible_width_move*pourcent_position_Fixe5/100;
   			pourcent_position_Fixe6 = 6*section*(-1);
   				result_move6= possible_width_move*pourcent_position_Fixe6/100;
   			pourcent_position_Fixe7 = 7*section*(-1);
   				result_move7= possible_width_move*pourcent_position_Fixe7/100;
   			pourcent_position_Fixe8 = 8*section*(-1);
   				result_move8= possible_width_move*pourcent_position_Fixe8/100;
   			pourcent_position_Fixe9 = 9*section*(-1);
   				result_move9= possible_width_move*pourcent_position_Fixe9/100;
   		}


   		

   		//alert(nbr_position);
   		switch (nbr_position) {
	    	case 1:       
	    	appel_section();
	        	if (pourcent_position_plus >=0 && pourcent_position_plus < section0) {    
	        		$("ul.menu_slide").css('transform', 'translate('+result_move0+'px)');

			    }
			    else if (pourcent_position_plus >=section0 && pourcent_position_plus <= 100) {    
	        		$("ul.menu_slide").css('transform', 'translate('+result_move1+'px)');
			    }
	        break;
	        case 2:
	        appel_section();
	        	if (pourcent_position_plus >=0 && pourcent_position_plus < section0) {    
	        		$("ul.menu_slide").css('transform', 'translate('+result_move0+'px)');
			    }
			    else if (pourcent_position_plus >=section0 && pourcent_position_plus < section1) {    
	        		$("ul.menu_slide").css('transform', 'translate('+result_move1+'px)');
			    }
			    else if (pourcent_position_plus >=section1 && pourcent_position_plus <= 100) {    
	        		$("ul.menu_slide").css('transform', 'translate('+result_move2+'px)');
			    } 
	        break;
	        case 3:
	        appel_section();
	        	if (pourcent_position_plus >=0 && pourcent_position_plus < section0) {    
	        		$("ul.menu_slide").css('transform', 'translate('+result_move0+'px)');
			    }
			    else if (pourcent_position_plus >=section0 && pourcent_position_plus < section1) {    
	        		$("ul.menu_slide").css('transform', 'translate('+result_move1+'px)');
			    }
			    else if (pourcent_position_plus >=section1 && pourcent_position_plus < section2) {    
	        		$("ul.menu_slide").css('transform', 'translate('+result_move2+'px)');
			    }
			    else if (pourcent_position_plus >=section2 && pourcent_position_plus <= 100) {    
	        		$("ul.menu_slide").css('transform', 'translate('+result_move3+'px)');
