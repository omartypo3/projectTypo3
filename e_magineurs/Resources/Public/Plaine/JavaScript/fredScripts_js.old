var obj = {
  "block_content_part5": "0.2",
  "parallax": "-0.1"

}
}else{
var obj = {
  "parallax": "-0.1"

}
}






$.each( obj, function( class_element, the_vitesse ) {

	scroll_parallax_go(class_element,the_vitesse);

	$(window).resize(function(){
			scroll_parallax_go(class_element,the_vitesse);
	});
});

