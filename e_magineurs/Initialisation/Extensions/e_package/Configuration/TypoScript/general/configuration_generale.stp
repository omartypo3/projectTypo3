page.includeCSS {
	fancybox = https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.1.20/jquery.fancybox.min.css
	fancybox.external = 1
}
page.javascriptLibs {
   jQuery = 1
   # (possible values: latest|1.7.2|…, default: latest)
   # Note: jQuery.source has to be a CDN like "google" when jQuery.version is not "latest"
   jQuery.version = latest
   # (possible values: local|google|jquery|msn, default: local)
   jQuery.source = google
   # si noConflict = 1, il faut remplacer les $ par jQuery dans les fichiers js
   jQuery.noConflict = 0
}
page.includeJSFooterlibs {
	fancybox = https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.1.20/jquery.fancybox.min.js
	fancybox {
		external = 1
		disableCompression = 1
		excludeFromConcatenation = 1
	}
	jQueryUI < .fancybox
	jQueryUI = https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js
	tether < .fancybox
	tether = https://cdnjs.cloudflare.com/ajax/libs/tether/1.4.0/js/tether.min.js
	bootstrap < .fancybox
	bootstrap = https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0-alpha.6/js/bootstrap.min.js
}
#page.includeJSFooter.basePackage = {$e_package.conf.dossierPublic}/JavaScript/basePackage.js

lib.canonical = TEXT
lib.canonical {
	typolink {
		parameter = {page:uid}
		parameter.insertData = 1
		useCacheHash = 1
		addQueryString = 1
		addQueryString {
			method = GET
			exclude = id
		}
		returnLast = url
	}
	wrap = <link rel="canonical" href="|" />
}
page.headerData.930 < lib.canonical

page.headerData.55 = TEXT
page.headerData.55 {
	insertData = 1
	value (
		<meta name="msapplication-config" content="none"/>
	    <!--[if lt IE 9]>
	    <script src="//cdnjs.cloudflare.com/ajax/libs/html5shiv/3.6.2/html5shiv.js"></script>
	    <script src="//cdnjs.cloudflare.com/ajax/libs/respond.js/1.2.0/respond.js"></script>
	    <![endif]-->
	)
}
page.headerData.998 >
page.meta {
	description = {$page.meta.description}
	description.override.field = description
	author = {$page.meta.author}
	author.override.field = author
	keywords = {$page.meta.keywords}
	keywords.override.field = keywords
	robots = index,follow
	robots {
		override.if.isTrue.field = no_search
		override = noindex,follow
	}
	viewport = width=device-width, initial-scale=1.0, user-scalable=1
    og:title {
        attribute = property
        field = title
    }
    og:site_name {
        attribute = property
        data = {$e_magineurs.conf.siteTitle}
    }
    og:description = {$page.meta.description}
    og:description {
        attribute = property
        field = description
    }
    og:image {
        attribute = property
        stdWrap.cObject = FILES
        stdWrap.cObject {
            references {
                data = levelfield:-1, media, slide
            }
            maxItems = 1
            renderObj = COA
            renderObj {
                10 = IMG_RESOURCE
                10 {
                    file {
                        import.data = file:current:uid
                        treatIdAsReference = 1
                        width = 526c
                        height = 275c
                    }
                    stdWrap {
                        typolink {
                            parameter.data = TSFE:lastImgResourceInfo|3
                            returnLast = url
                            forceAbsoluteUrl = 1
                        }
                    }
                }
            }
        }
    }
}
[(request.getQueryParams()['tx_news_pi1'] ?? [])['news'] ?? 0 > 0]
	page.meta {
		og:title >
		og:image >
		og:description >
	}
[end]
