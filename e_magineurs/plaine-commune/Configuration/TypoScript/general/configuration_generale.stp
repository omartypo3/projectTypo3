page.includeJS {
	solrSearchQuery = {$e_magineurs.conf.dossierPublic}/JavaScript/solrSearchQuery.js
	solrSearchQuery {
		forceOnTop = 1
		async = 1
	}
	Twitter = {$e_magineurs.conf.dossierPublic}/JavaScript/Twitter.js
	Twitter {
		forceOnTop = 1
	}
}


page.includeJS {
	initialScroll = {$e_magineurs.conf.dossierPublic}/JavaScript/initialScroll.js
	initialScroll {
		forceOnTop = 1
	}
	tarteaucitron = EXT:stratis_common/Resources/Public/JavaScript/Library/Tarteaucitron/tarteaucitron.js
    tarteaucitron_services = EXT:stratis_common/Resources/Public/JavaScript/Library/Tarteaucitron/tarteaucitron.services.js
	stratis_tarteaucitron = /stratis_tarteaucitron.js
	stratis_tarteaucitron.external = 1
	tarteaucitron_servicesstratis = EXT:stratis_common/Resources/Public/JavaScript/Library/Tarteaucitron/stratis.tarteaucitron.services.js
    stratis_tarteaucitron_bundle = EXT:stratis_common/Resources/Public/JavaScript/Library/Tarteaucitron/stratis-tarteaucitron.bundle.js
    advertising = EXT:stratis_common/Resources/Public/JavaScript/Library/Tarteaucitron/advertising.js
}

[page["uid"] == {$e_magineurs.conf.homePage}]
page.headerData.57 = TEXT
page.headerData.57 {
	value (
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	)
}
[end]
