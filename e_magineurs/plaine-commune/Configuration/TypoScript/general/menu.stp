lib.filAriane = COA
lib.filAriane {
    wrap = <nav class="ariane" role="navigation" aria-label="Fil d'Ariane"><ul>|</ul></nav>
    5 = TEXT
    5 {
        value = Accueil
        typolink {
            parameter = {$e_magineurs.conf.homePage}
        }
        wrap = <li class="ir filHome">|<i class="icon-LinkText"></i></li>
    }
    25 = HMENU
    25 {
        special = rootline
        special.range = 1|-1
        1 = TMENU
        1{
            NO = 1
            NO.stdWrap.field = nav_title // title
            NO.allWrap = <li class="item crop">|</li>
            IFSUB = 1
            IFSUB.wrapItemAndSub = <li class="item crop test">|</li>
            NO.ATagParams = class="openFil"
            NO.stdWrap.wrap = <span>|</span>
            NO.stdWrap2.append = HMENU
            NO.stdWrap2.append {
                special = directory
                special.value = {field:pid}
                special.value.stdWrap.insertData = 1
                wrap = <ul class="menuFil">|</ul>
                1 = TMENU
                1 {
                    NO = 1
                    NO.stdWrap.field = nav_title // title
                    NO.allWrap = <li>|</li>
                    CUR < .NO
                    CUR.ATagParams = class="active"
                    ACT < .CUR
                }
            }
            CUR < .NO
            ACT < .NO
        }
    }
}
