lib.menuFooterContact = HMENU
lib.menuFooterContact {
    wrap = <ul>|</ul>
    special = list
    special.value = {$e_magineurs.conf.menuFooterContact.list}
    1 = TMENU
    1 {
        NO = 1
        NO.wrapItemAndSub = <li><i class="icon-Archives"></i>|</li>||<li><i class="icon-Newsletter"></i>|</li>||<li><i class="icon-EnglishPage"></i>|</li>
        NO.stdWrap.field = nav_title // title
    }
}


#menu sites
tt_content.menu_Sites =< tt_content.menu_pages
tt_content.menu_Sites.templateName = MenuSites

#menu Home
tt_content.menu_Home =< tt_content.menu_sitemap_pages
tt_content.menu_Home.templateName = MenuHome
