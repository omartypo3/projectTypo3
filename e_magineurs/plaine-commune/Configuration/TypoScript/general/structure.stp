page = PAGE
page {
    10 {
        templateName = TEXT
		templateName.stdWrap.cObject = CASE
		templateName.stdWrap.cObject {
			key.data = pagelayout
			default = TEXT
			default.value = Default
			1 = TEXT
			1.value = Default
			2 = TEXT
			2.value = Accueil
			3 = TEXT
			3.value = PageSansColonne
			4 = TEXT
			4.value = Newsletter
			14 = TEXT
			14.value = DetailPublication
			0 < .default
		}
        variables {
        	# Ajoutez vos variables ici
        	# variables existantes dans le package :
        	# dossierPublic = {$e_magineurs.conf.dossierPublic}
			# homePage = {$e_magineurs.conf.homePage}
			# dossierLangue = LLL:{$e_package.conf.dossierLangue}/locallang.xlf
        }
    }
}

# active la popup sur les images du RTE
lib.contentElement.settings.media.popup.enable = 1
lib.contentElement.settings.media.popup.directImageLink = 1

# Récupérer une image de l'onglet ressources d'une page
# <f:cObject typoscriptObjectPath='lib.imagePage' data='{sourceUid: data.uid}' />
lib.imagePage = FILES
lib.imagePage {
	references {
		table = pages
		uid.field = sourceUid
		fieldName = media
	}
	renderObj = IMAGE
	renderObj {
		file {
			import.data = file:current:publicUrl
		}
	}
}

lib.imageGridInfoBulle = FILES
lib.imageGridInfoBulle {
	references {
		table = tt_content
		uid.field = sourceUid
		fieldName = image
	}
	renderObj = IMAGE
	renderObj {
		file {
			import.data = file:current:publicUrl
		}
	}
}

#Exemple de récupération d'une image des propriétés d'une page. L'objet lib.imagePage est créé dans le package
lib.imagePageDefaut < lib.imagePage
lib.imagePageDefaut.renderObj{
	file {
		#width = 1980c
		#height = 406c
	}
}

#Exemple de récupération d'une image des propriétés d'une page. L'objet lib.imagePage est créé dans le package
lib.imageHome < lib.imagePage
lib.imageHome.renderObj.file {
	width = 1980c
	height = 949c
}
lib.imageHome.renderObj.params = class="backgroundHome"

lib.connexionTop = EXTBASEPLUGIN
lib.connexionTop {
    extensionName = Felogin
    pluginName = Login
    vendorName = TYPO3\CMS
    settings {
        pages = 194
        recursive = 0
        showForgotPassword = 1
        showPermaLogin = 1
        redirectMode = login
        redirectFirstMethod = 1
        redirectPageLogin = 203
        redirectPageLoginError = 203
        redirectPageLogout = 203
        dateFormat = Y-m-d H:i
        welcomeHeader_stdWrap.wrap = <h3>|</h3>
        welcomeMessage_stdWrap.wrap = <p>|</p>
        successMessage_stdWrap.wrap = <p>|</p>
        logoutMessage_stdWrap.wrap = <p>|</p>
        errorMessage_stdWrap.wrap = <p>|</p>
        forgotErrorMessage_stdWrap.wrap = <p>|</p>
        forgotMessage_stdWrap.wrap = <p>|</p>
    }
    view {
        templateRootPaths.100 = EXT:e_magineurs/plaine-commune/Resources/Extensions/felogin/
    }
    _LOCAL_LANG {
        fr {
            ll_error_message = Une erreur est survenue durant la connexion.
            ll_forgot_reset_message = Veuillez saisir votre nom d'utilisateur ou votre email. Les instructions à la réinitialisation de votre mot de passe vous seront envoyées par mail.
        }
    }
}

lib.infoHeaderConnexion = CONTENT
lib.infoHeaderConnexion {
    table = tt_content
    select.pidInList = {$e_magineurs.conf.infoHeaderConnexion}
}


