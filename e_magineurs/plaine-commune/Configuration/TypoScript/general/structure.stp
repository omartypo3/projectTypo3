#récuperation du munu de "restons connectés"
lib.stayConnect = CONTENT
lib.stayConnect {
	table = tt_content
	select {
		pidInList.field = sourceUid
		where = colPos = 2
        orderBy = sorting ASC
	}
}

lib.categories = CONTENT
lib.categories {
   table = pages
   select {
       languageField = pages.sys_language_uid
       uidInList.field = recordUid
       pidInList = 1
       recursive = 99
       selectFields = sys_category.title
       join = sys_category_record_mm ON pages.uid = sys_category_record_mm.uid_foreign JOIN sys_category ON sys_category.uid = sys_category_record_mm.uid_local
       where = sys_category_record_mm.tablenames = 'pages'
       where = sys_category.parent = '30'
       #en local => where = sys_category.parent = '23'
       orderBy = sys_category.sorting

   }
   renderObj = TEXT
   renderObj {
       field = title
       wrap = |
   }
}



#récuperation du chapo
lib.chapo = CONTENT
lib.chapo {
	table = tt_content

	select {
		pidInList.field = sourceUid
		where = colPos = 2
	}

	renderObj = TEXT
	renderObj {
		field = bodytext
		stripHtml = 1
	}
}


# Récupérer d'une video de l'onglet ressources d'une page
# <f:cObject typoscriptObjectPath='lib.videoPage' data='{sourceUid: data.uid}' />
lib.videoPage = FILES
lib.videoPage {
	references {
		table = pages
		uid.field = sourceUid
		fieldName = media
	}
	renderObj = TEXT
	renderObj {
		data = file:current:publicUrl
		noTrimWrap (
	    |
	            <source src="|"  type="video/mp4" />||
	    )
	}
}



# Récupérer l'extension (format) un fichier
# <f:cObject typoscriptObjectPath='lib.extensionFormat' data='{sourceUid: data.uid}' />
lib.extensionFormat = FILES
lib.extensionFormat {
	references {
		table = pages
		uid.field = sourceUid
		fieldName = media
	}
	renderObj = TEXT
	renderObj {
		data = file:current:extension

	}
}


# Récupérer d'une image selon colpos
# <f:cObject typoscriptObjectPath='lib.imageColPos4'/>
lib.imageColPos4 = CONTENT
lib.imageColPos4 {
	table = tt_content

	select {
		pidInList.data = TSFE:id
		where = colPos = 4
	}

	renderObj = FILES
	renderObj {
		references{
			table = tt_content
			uid.field = uid
			fieldName = assets
		}

		renderObj = IMAGE
		renderObj {
			file.import.data = file:current:publicUrl
			params = class="img_bg_home5"
		}
	}
}

lib.videoColPos4 = CONTENT
lib.videoColPos4 {
   table = tt_content

   select {
       pidInList.data = TSFE:id
       where = colPos = 4
   }

   renderObj = FILES
   renderObj {
       references{
           table = tt_content
           uid.field = uid
           fieldName = assets
       }

       renderObj = TEXT
       renderObj {
           data = file:current:publicUrl
           noTrimWrap (
  		    |
  		            <source src="|"  type="video/mp4" />||
  		    )

       }
   }
}


# Récupérer l'extension (format) un fichier d'un un colpos
# <f:cObject typoscriptObjectPath='lib.extensionFormatColPos4'/>

lib.extensionFormatColPos4 = CONTENT
lib.extensionFormatColPos4 {
   table = tt_content

   select {
       pidInList.data = TSFE:id
       where = colPos = 4
   }

   renderObj = FILES
   renderObj {
       references{
           table = tt_content
           uid.field = uid
           fieldName = assets
       }

       renderObj = TEXT
       renderObj {
			data = file:current:extension
		}
   }
}


