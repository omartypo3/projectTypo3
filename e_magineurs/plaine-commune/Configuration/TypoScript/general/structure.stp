lib.getIdOffre = TEXT
lib.getIdOffre.data = GP:tx_eannuaires_pi1|offre



lib.intituleEmploi = RECORDS
lib.intituleEmploi{
   dontCheckPid = 1
   tables = tx_eannuaires_domain_model_fiche
   source.data = GP:tx_eannuaires_pi1|offre
   source.intval = 1
   conf.tx_eannuaires_domain_model_fiche = TEXT
   conf.tx_eannuaires_domain_model_fiche {
       field = title
       htmlSpecialChars = 1
   }
}

lib.refEmploi = RECORDS
lib.refEmploi{
    dontCheckPid = 1
    tables = tx_eannuaires_domain_model_fiche
    source.data = GP:tx_eannuaires_pi1|offre
    source.intval = 1
    conf.tx_eannuaires_domain_model_fiche = TEXT
    conf.tx_eannuaires_domain_model_fiche {
        field = bp
        htmlSpecialChars = 1
    }
}




//récupération de la catégorie gestion doc
lib.categoriesDoc = CONTENT
lib.categoriesDoc {
    table = sys_file
    select {
        uidInList.field = sourceUid
        pidInList = 0
        selectFields = sys_category.title AS catTitle
        join = sys_file_metadata ON sys_file.uid = sys_file_metadata.file join sys_category_record_mm on sys_file_metadata.uid = sys_category_record_mm.uid_foreign join sys_category on sys_category_record_mm.uid_local = sys_category.uid
		where = sys_category_record_mm.tablenames = 'sys_file_metadata'
    }
    renderObj = TEXT
    renderObj {
        field = catTitle
        stdWrap.noTrimWrap = | ||
    }
}



#social share
lib.emailPage = TEXT
lib.emailPage {
	value =  Envoyer par email
	wrap = <div class="itemMail"><a href="javascript:emailCurrentPage()">|</a></div>
}


## CARTO ##
lib.paramPoiNews = TEXT
lib.paramPoiNews {
	typolink {
	    parameter = {$e_magineurs.conf.idPageMap}
	    additionalParams.field = sourceUid
	    additionalParams.wrap = &tx_egmap_gmap[pois]=tx_news_domain_model_news_|
		useCacheHash = 1
	}
    value = Voir sur la carte
}

lib.paramPoiAnnuaire = TEXT
lib.paramPoiAnnuaire {
	typolink {
	    parameter = {$e_magineurs.conf.idPageMap}
	    additionalParams.field = sourceUid
	    additionalParams.wrap = &tx_egmap_gmap[pois]=tx_eannuaires_domain_model_fiche_|
		useCacheHash = 1
	}
    value = Afficher le plan
}


lib.uidPage = TEXT
lib.uidPage.data = GP:tx_news_pi1|news

lib.cat0 = TEXT
lib.cat0.data = GP:cat

lib.cat1 = TEXT
lib.cat1.data = GP:cat2

lib.cat2 = TEXT
lib.cat2.data = GP:cat3



lib.math = TEXT
lib.math {
  current = 1
  prioriCalc = 1
}

lib.getFooterNewsletter = CONTENT
lib.getFooterNewsletter {
	table = tt_content
	select {
		pidInList = {$e_magineurs.conf.idPageNewsletterBlock}
		max = 1
		where = CType LIKE '%newsletterwidg%'
		selectFields = uid
	}

	renderObj = TEXT
	renderObj {
		field = uid
		wrap = |,
	}
}

lib.getPopUpNewsletter = CONTENT
lib.getPopUpNewsletter {
	table = tt_content
	select {
		pidInList = {$e_magineurs.conf.idPageSiteConfigFolder}
		max = 1
		where = CType LIKE '%popupnewsletterwidg%'
		selectFields = uid
	}

	renderObj = TEXT
	renderObj {
		field = uid
		wrap = |,
	}
}
