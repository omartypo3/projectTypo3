lib.menuGauche = HMENU
 lib.menuGauche {

    # We define the first level as text menu.
    1 = TMENU

    1{
        # We define the normal state ("NO").
        
        wrap = <ul class="ul_niveau1">|</ul>
        NO.doNotLinkIt = 0
        NO.wrapItemAndSub = <li class="li_niveau1">|</li>
        # Wrap the whole first level.
        #wrap = <ul class="ul_niveau1">|</ul>
        ACT = 1
        ACT.wrapItemAndSub = <li class="li_niveau1 current">|</li>
    }
    # The second and third level should be configured exactly
    # the same way.
    # In between the curly brackets, objects can be copied.
    # With the dot "." we define that the object can be found
    # in the brackets.
    # With 2.wrap and 3.wrap we overwrite the wrap, which was
    # copied from 1.wrap.
    2 < .1
    2{
        wrap = <ul class="ul_niveau2">|</ul>
        NO.doNotLinkIt = 0
        NO.wrapItemAndSub = <li class="li_niveau2">|</li>
        ACT = 1
        ACT.wrapItemAndSub = <li class="li_niveau2 current">|</li>
    }

    3 < .1
    3{
        wrap = <ul class="ul_niveau3">|</ul>
        NO.doNotLinkIt = 0
        NO.wrapItemAndSub = <li class="li_niveau3">|</li>
        ACT = 1
        ACT.wrapItemAndSub = <li class="li_niveau3 current">|</li>
    }

    4 < .1
    4{
        wrap = <ul class="ul_niveau4">|</ul>
        NO.doNotLinkIt = 0
        NO.wrapItemAndSub = <li class="li_niveau4">|</li>
        ACT = 1
        ACT.wrapItemAndSub = <li class="li_niveau4 current">|</li>
    }
}

lib.base_menu_gauche = HMENU
lib.base_menu_gauche {

    # We define the first level as text menu.
    1 = TMENU

    1{
        # We define the normal state ("NO").
        wrap = |
        NO.wrapItemAndSub = <span style="display: none;">|</span>
        ACT = 1
        ACT.doNotLinkIt = 1
        ACT.wrapItemAndSub = <p class="titre_rubrique">|</p>
    }
}



# tt_content.menu_miniicon =< tt_content.menu_pages
# tt_content.menu_miniicon.templateName = MenuMiniicon

tt_content.menu_miniicon =< tt_content.menu_sitemap_pages
tt_content.menu_miniicon {
    templateName = MenuMiniicon
    dataProcessing {
        10 {
            special = directory
            special.value.field = pages
            levels = 2
            expandAll = 1
            includeSpacer = 1
        }
    }
}

lib.filArianeNavigation = COA
lib.filArianeNavigation {
    wrap = <nav class="ariane"><ul>|</ul></nav>
    5 = TEXT
    5 {
        value = Accueil
        typolink {
            parameter = {$e_magineurs.conf.homePage}
        }
        wrap = <li class="ir filHome" >|</li>
    }
    25 = HMENU
    25 {
        special = rootline
        special.range = 1|-1
        1 = TMENU
        1{
            NO = 1
            NO.stdWrap.field = nav_title // title
            NO.allWrap = <li class="item">|</li>
            NO.ATagParams = class="openFil"
            NO.stdWrap.wrap = <span>|</span>
            NO.stdWrap2.append = HMENU
            NO.stdWrap2.append {
                special = directory
                special.value = {field:pid}
                special.value.stdWrap.insertData = 1
                wrap = <ul class="menuFil">|</ul>
                1 = TMENU
                1 {
                    NO = 1
                    NO.stdWrap.field = nav_title // title
                    NO.allWrap = <li>|</li>
                    CUR < .NO
                    CUR.ATagParams = class="active"
                    ACT < .CUR
                }
            }
            CUR < .NO
            ACT < .NO
        }
    }
}


lib.filAriane = COA
lib.filAriane.wrap = <nav class="ariane"><ul>|</ul></nav>
lib.filAriane.10 = HMENU
lib.filAriane.10 {
    special = rootline
    #commenter la ligne suivante pour afficher un lien vers la page d'accueil
    special.range = 1|-1
    1 = TMENU
    1{ 
        NO = 1
        NO.allWrap = <li>|</li>
        NO.stdWrap.field = nav_title // title
        CUR < .NO
        CUR.doNotLinkIt = 1
        ACT < .NO
    }
}

