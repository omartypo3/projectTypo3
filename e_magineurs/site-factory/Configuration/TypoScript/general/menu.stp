tt_content.menu_miniHead =< tt_content.menu_pages
tt_content.menu_miniHead.templateName = MenuHead

tt_content {
    menu_secondaire =< tt_content.menu_pages
    menu_secondaire {
        templateName = MenuSecondaire
        dataProcessing{
            10 {
                special = list
                special.value.field = pages
                levels = {$e_magineurs.conf.MenuSecondaire.levels}
                expandAll = 1
                includeSpacer = 1
            }
        }
    }   
}



