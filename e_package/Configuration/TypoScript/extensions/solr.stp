plugin.tx_solr {
	solr {
		host   = {$e_magineurs.tx_solr.solr.prod.host}
		port   = {$e_magineurs.tx_solr.solr.prod.port}
		path   = {$e_magineurs.tx_solr.solr.prod.path}
	}
}
[getenv("SITE_ENV") == "DEV"] || [getenv("REDIRECT_SITE_ENV") == "DEV"] 
	plugin.tx_solr {
		solr {
			host   = {$e_magineurs.tx_solr.solr.dev.host}
			port   = {$e_magineurs.tx_solr.solr.dev.port}
			path   = {$e_magineurs.tx_solr.solr.dev.path}
		}
	}
[end]
[getenv("SITE_ENV") == "PREPROD"] || [getenv("REDIRECT_SITE_ENV") == "PREPROD"] 
	plugin.tx_solr {
		solr {
			host   = {$e_magineurs.tx_solr.solr.preprod.host}
			port   = {$e_magineurs.tx_solr.solr.preprod.port}
			path   = {$e_magineurs.tx_solr.solr.preprod.path}
		}
	}
[end]
[getenv("SITE_ENV") == "LOCAL"] || [getenv("REDIRECT_SITE_ENV") == "LOCAL"] 
	plugin.tx_solr {
		solr {
			host   = {$e_magineurs.tx_solr.solr.local.host}
			port   = {$e_magineurs.tx_solr.solr.local.port}
			path   = {$e_magineurs.tx_solr.solr.local.path}
		}
	}
[end]

plugin.tx_solrfluid {
	view {
		layoutRootPaths.20 = {$e_magineurs.conf.dossierExtensions}/{$e_magineurs.tx_solrfluid.view.layoutRootPath}
		partialRootPaths.20 = {$e_magineurs.conf.dossierExtensions}/{$e_magineurs.tx_solrfluid.view.partialRootPath}
		templateRootPaths.20 = {$e_magineurs.conf.dossierExtensions}/{$e_magineurs.tx_solrfluid.view.templateRootPath}
		widget.ApacheSolrForTypo3\Solrfluid\ViewHelpers\Widget\ResultPaginateViewHelper.templateRootPath = {$e_magineurs.conf.dossierExtensions}/paginate/
	}
}

page {
	includeJSFooterlibs {
    	solr-jquery >
    	solr-ui >
	}
	includeCSS {
		search >
		solr-ui >
	}
}

plugin.tx_solr {
	javascriptFiles.library >
	general.dateFormat.date = {$e_magineurs.tx_solr.general.dateFormat.date}

	templateFiles {
		results= {$e_magineurs.conf.dossierExtensions}/solr/results.htm
	}

	index {
		enableFileIndexing {
			# pageContext - index files from tt_content, shown in indexed frontend pages
			pageContext = 1
			pageContext {
				# restrict indexed files extensions to index
				fileExtensions = xls,xlsx,doc,docx,ppt,pptx,odt,pdf,zip,ods,odp
			}
			# Storage Context is indexing the file-system for example creating a download area
			storageContext = 0
			storageContext {
				2 {
					# restrict indexed files extensions to index
					fileExtensions = xls,xlsx,doc,docx,ppt,pptx,odt,pdf,zip,ods,odp
					# FAL generally does not have enable fields, but metadata ships fields which can be used for that purpose
					enableFields {
						accessGroups >
						endtime >
					}
				}
			}
			# Activates Indexing of Files attached to TCA records (like news), needs further configuration in queue
			recordContext = 1
			recordContext {
				# restrict indexed files extensions to index
				fileExtensions = xls,xlsx,doc,docx,ppt,pptx,odt,pdf,zip,ods,odp
			}
		}
		queue {

			pages = {$e_magineurs.tx_solr.index.queue.pages} 
			pages {
	            fields {
					type_stringS = TEXT
					type_stringS.value = Pages
					url = TEXT
					url {
						typolink {
							parameter = {field:uid}
							parameter.insertData = 1
							forceAbsoluteUrl = 1
							returnLast = url
						}
					}
	            }
			}
					
			
			// Merged configuration for tx_news_domain_model_news (Actualités + Communiqués de presse + Agenda)
			tx_news_domain_model_news = 1
			tx_news_domain_model_news {
				table = tx_news_domain_model_news
				// Combine ALL PIDs: actualite (3,441) + presse (294) + agenda (4,224)
				additionalWhereClause = pid IN ({$e_magineurs.tx_solr.index.queue.actualite.pidActualites}) OR pid IN ({$e_magineurs.tx_solr.index.queue.presse.pidActualites}) OR pid IN ({$e_magineurs.tx_solr.index.queue.agenda.pidAgenda})
				fields {
					// Conditional type_stringS based on PID
					type_stringS = CASE
					type_stringS {
						key.data = field:pid
						// Presse PID: 294
						294 = TEXT
						294.value = Communiqué de presse
						// Agenda PIDs: 4, 224
						4 = TEXT
						4.value = Agenda
						224 = TEXT
						224.value = Agenda
						// Actualité PIDs: 3, 441 (default)
						default = TEXT
						default.value = Actualité
					}
					// Conditional icon_stringS based on PID
					icon_stringS = CASE
					icon_stringS {
						key.data = field:pid
						// Presse PID: 294
						294 = TEXT
						294.value = presse
						// Agenda PIDs: 4, 224
						4 = TEXT
						4.value = agenda
						224 = TEXT
						224.value = agenda
						// Actualité PIDs: 3, 441 (default)
						default = TEXT
						default.value = actualite
					}
					title = title
					categorysearch_textM = COA
					categorysearch_textM.10 = SOLR_RELATION
					categorysearch_textM.10 {
						localField = categories
						foreignLabelField = title
						multiValue = 0
					}				    
					categorysearch_textM.stdWrap.split {
						token = ,
						returnKey = 0				
					}
					// Common date field for actualité/presse
					date_stringS = datetime
					// Agenda-specific date fields (only for PIDs 4, 224)
					datedebut_stringS = begindate
					datefin_stringS = finishdate
					// Agenda-specific location fields (only for PIDs 4, 224)
					nomlieu_textS = nom_lieu
					adresse_textS = adressetout
					ville_textM = SOLR_RELATION 
					ville_textM {
						foreignTable = tx_enews_domain_model_commune
						foreignLabelField = title
						localField = ville
						multiValue = 1				
					}
					codePostal_textM = SOLR_RELATION
					codePostal_textM {
						foreignTable = tx_enews_domain_model_commune
						foreignLabelField = code_postal
						localField = ville
						multiValue = 1				
					}
					image_textS = FILES
					image_textS {
						references {
							table= tx_news_domain_model_news
							uid.data = field:uid
							fieldName= fal_media
						}
                        begin = 0
                        maxItems = 1
						renderObj = TEXT
						renderObj {
							stdWrap.data = file:current:publicUrl
							stdWrap.wrap = |
						}
					}
					teaser_textS = teaser
					content = TEXT
					content {
						field = bodytext
						stripHtml = 1
					}
					// Conditional URL based on PID
					url = CASE
					url {
						key.data = field:pid
						// Presse PID: 294 -> detail page 108
						294 = TEXT
						294 {
							typolink {
								parameter = {$e_magineurs.tx_solr.index.queue.presse.pidActualitesDetail}
								additionalParams = &tx_news_pi1%5Bnews%5D={field:uid}&tx_news_pi1%5Bcontroller%5D=News&tx_news_pi1%5Baction%5D=detail
								additionalParams.insertData = 1
								useCacheHash = 1
								returnLast = url
							}
						}
						// Agenda PIDs: 4, 224 -> detail page 28
						4 = TEXT
						4 {
							typolink {
								parameter = {$e_magineurs.tx_solr.index.queue.agenda.pidAgendaDetail}
								additionalParams = &tx_news_pi1%5Bnews%5D={field:uid}&tx_news_pi1%5Bcontroller%5D=News&tx_news_pi1%5Baction%5D=detail
								additionalParams.insertData = 1
								useCacheHash = 1
								returnLast = url
							}
						}
						224 = TEXT
						224 {
							typolink {
								parameter = {$e_magineurs.tx_solr.index.queue.agenda.pidAgendaDetail}
								additionalParams = &tx_news_pi1%5Bnews%5D={field:uid}&tx_news_pi1%5Bcontroller%5D=News&tx_news_pi1%5Baction%5D=detail
								additionalParams.insertData = 1
								useCacheHash = 1
								returnLast = url
							}
						}
						// Actualité PIDs: 3, 441 -> detail page 26
						default = TEXT
						default {
							typolink {
								parameter = {$e_magineurs.tx_solr.index.queue.actualite.pidActualitesDetail}
								additionalParams = &tx_news_pi1%5Bnews%5D={field:uid}&tx_news_pi1%5Bcontroller%5D=News&tx_news_pi1%5Baction%5D=detail
								additionalParams.insertData = 1
								useCacheHash = 1
								returnLast = url
							}
						}
					}
				}
				// Attachments configuration (all use same fields)
				attachments = {$e_magineurs.tx_solr.index.queue.actualite.attachements}
				attachments {
				    fields = {$e_magineurs.tx_solr.index.queue.actualite.attachements.fields}
				}
			}
			faq < .actualite
			faq = {$e_magineurs.tx_solr.index.queue.faq}
			faq {
				additionalWhereClause =  pid IN ({$e_magineurs.tx_solr.index.queue.faq.pidFaq})
				fields >
				fields {
					type_stringS = TEXT
					type_stringS.value = Foire aux questions
					title = title
					content = TEXT
					content {
						field = bodytext
						stripHtml = 1
					}
					url = TEXT
					url {
						typolink {
							parameter = {$e_magineurs.tx_solr.index.queue.faq.pidFaqDetail}
							additionalParams = &tx_news_pi1%5Bnews%5D={field:uid}&tx_news_pi1%5Bcontroller%5D=News&tx_news_pi1%5Baction%5D=detail
							additionalParams.insertData = 1
							useCacheHash = 1
							returnLast = url
						}
					}
				}
				attachments = {$e_magineurs.tx_solr.index.queue.faq.attachements}
				attachments {
				    fields = {$e_magineurs.tx_solr.index.queue.actualite.attachements.fields}
				}
			}
			// Merged configuration for tx_eannuaires_domain_model_fiche (Annuaire personnes + Annuaire lieux + Galerie vidéo)
			tx_eannuaires_domain_model_fiche = 1
			tx_eannuaires_domain_model_fiche {
				table = tx_eannuaires_domain_model_fiche
				// Combine ALL PIDs: annuaire_des_personnes (23) + annuaires_des_lieux (39) + galerie_video (24)
				additionalWhereClause = pid IN ({$e_magineurs.tx_solr.index.queue.annuaire_des_personnes.pidAnnuairePersonnes}) OR pid IN ({$e_magineurs.tx_solr.index.queue.annuaires_des_lieux.pidAnnuaireLieux}) OR pid IN ({$e_magineurs.tx_solr.index.queue.galerie_video.pidGalerieVideo})
				fields {
					// Conditional type_stringS based on PID
					type_stringS = CASE
					type_stringS {
						key.data = field:pid
						// Annuaire des personnes PID: 23
						23 = TEXT
						23.value = Annuaire des personnes
						// Annuaire des lieux PID: 39
						39 = TEXT
						39.value = Annuaire des lieux
						// Galerie vidéo PID: 24
						24 = TEXT
						24.value = Vidéo
						// Default
						default = TEXT
						default.value = Annuaire
					}
					// Conditional icon_stringS based on PID
					icon_stringS = CASE
					icon_stringS {
						key.data = field:pid
						// Annuaire des personnes PID: 23
						23 = TEXT
						23.value = personnes
						// Annuaire des lieux PID: 39
						39 = TEXT
						39.value = lieux
						// Galerie vidéo PID: 24
						24 = TEXT
						24.value = video
						// Default
						default = TEXT
						default.value = annuaire
					}
					// Common field: title (used by lieux and video, mapped from title field for personnes)
					title = title
					// Personnes-specific fields (PID 23)
					nom_textS = title
					prenom_textS = firstname
					cell_textS = cantonstexte
					// Lieux-specific fields (PID 39)
					adresse_textS = address
					codePostal_textM = zipcode
					ville_textM = SOLR_RELATION
					ville_textM {
						localField = city
						foreignLabelField = title
						multiValue = 1
					}
					siteTitre_textM = SOLR_RELATION
					siteTitre_textM {
						localField = liens
						foreignLabelField = titre
						multiValue = 1
					}
					site_textM = SOLR_RELATION
					site_textM {
						localField = liens
						foreignLabelField = url
						multiValue = 1
					}
					// Video-specific fields (PID 24)
					content = TEXT
					content {
						field = description
						stripHtml = 1
					}
					duree_textS = cell
					// Common category fields (lieux and video)
					category_stringM = SOLR_RELATION
					category_stringM {
						localField = categories
						foreignLabelField = title
						multiValue = 0
					}
					categoryfacets_stringM = SOLR_RELATION
					categoryfacets_stringM {
						localField = categories
						foreignLabelField = title
						multiValue = 1
					}
					// Common fields: phone and email
					phone_textS = phone
					mail_textS = email
					// Common image field (personnes uses photo_textS, lieux/video use image_textS)
					photo_textS = FILES
					photo_textS {
						references {
							table= tx_eannuaires_domain_model_fiche
							uid.data = field:uid
							fieldName = image
						}
                        begin = 0
                        maxItems = 1
						renderObj = TEXT
						renderObj {
							stdWrap.data = file:current:publicUrl
							stdWrap.wrap = |
						}
					}
					image_textS = FILES
					image_textS {
						references {
							table= tx_eannuaires_domain_model_fiche
							uid.data = field:uid
							fieldName = image
						}
                        begin = 0
                        maxItems = 1
						renderObj = TEXT
						renderObj {
							stdWrap.data = file:current:publicUrl
							stdWrap.wrap = |
						}
					}
					// Conditional URL based on PID
					url = CASE
					url {
						key.data = field:pid
						// Annuaire des personnes PID: 23 -> detail page 61
						23 = TEXT
						23 {
							typolink {
								parameter = {$e_magineurs.tx_solr.index.queue.annuaire_des_personnes.pidAnnuairePersonneDetail}
								additionalParams = &tx_eannuaires_pi1%5Bfiche%5D={field:uid}&tx_eannuaires_pi1%5Baction%5D=show&tx_eannuaires_pi1%5Bcontroller%5D=Fiche
								additionalParams.insertData = 1
								returnLast = url
								useCacheHash = 1
							}
						}
						// Annuaire des lieux PID: 39 -> detail page 62
						39 = TEXT
						39 {
							typolink {
								parameter = {$e_magineurs.tx_solr.index.queue.annuaires_des_lieux.pidAnnuaireLieuxDetail}
								additionalParams = &tx_eannuaires_pi1%5Bfiche%5D={field:uid}&tx_eannuaires_pi1%5Baction%5D=show&tx_eannuaires_pi1%5Bcontroller%5D=Fiche
								additionalParams.insertData = 1
								returnLast = url
								useCacheHash = 1
							}
						}
						// Galerie vidéo PID: 24 -> detail page 230
						24 = TEXT
						24 {
							typolink {
								parameter = {$e_magineurs.tx_solr.index.queue.galerie_video.pidGalerieVideoDetail}
								additionalParams = &tx_eannuaires_pi1%5Bfiche%5D={field:uid}&tx_eannuaires_pi1%5Baction%5D=show&tx_eannuaires_pi1%5Bcontroller%5D=Fiche
								additionalParams.insertData = 1
								returnLast = url
								useCacheHash = 1
							}
						}
						// Default
						default = TEXT
						default {
							typolink {
								parameter = {$e_magineurs.tx_solr.index.queue.annuaire_des_personnes.pidAnnuairePersonneDetail}
								additionalParams = &tx_eannuaires_pi1%5Bfiche%5D={field:uid}&tx_eannuaires_pi1%5Baction%5D=show&tx_eannuaires_pi1%5Bcontroller%5D=Fiche
								additionalParams.insertData = 1
								returnLast = url
								useCacheHash = 1
							}
						}
					}
				}
				// Attachments configuration
				attachments = {$e_magineurs.tx_solr.index.queue.annuaire_des_personnes.attachements}
				attachments {
				    fields = {$e_magineurs.tx_solr.index.queue.annuaire_des_personnes.attachements.fields}
				}
			}
			sys_file_collection = {$e_magineurs.tx_solr.index.queue.galeriePhoto}
			sys_file_collection {
				table = sys_file_collection		
				additionalWhereClause = pid IN ({$e_magineurs.tx_solr.index.queue.galerie_photo.pidGaleriePhoto})
				fields {
					title = title
					type_stringS = TEXT
					type_stringS.value = Galerie photo
					randomAsset_stringS = FILES
	                randomAsset_stringS {
	                    sorting = rand()
	                    collections.field = uid
	                    maxItems = 1
	                    renderObj = TEXT
	                    renderObj {
	                        stdWrap.data = file:current:uid
	                    }
	                }
					mainAsset_stringS = main_asset
					content = TEXT
					content {
						field = webdescription
						stripHtml = 1
					}
					url = TEXT
					url {
						typolink {
							parameter = {$e_magineurs.tx_solr.index.queue.galerie_photo.pidGaleriePhotoDetail}
							additionalParams = &tx_fsmediagallery_mediagallery%5BmediaAlbum%5D={field:uid}
							additionalParams.insertData = 1
							returnLast = url
							useCacheHash = 1
						}
					}
				}
			}
			tx_dpnglossary_domain_model_term = {$e_magineurs.tx_solr.index.queue.glossaire}
			tx_dpnglossary_domain_model_term {
				table = tx_dpnglossary_domain_model_term
				additionalWhereClause = pid IN ({$e_magineurs.tx_solr.index.queue.glossaire.pidGlossaire})
				fields {
					type_stringS = TEXT
					type_stringS.value = Glossaire
					title = name
					content = SOLR_RELATION
					content {
						localField = descriptions
						foreignLabelField = text
						multiValue = 1
					}
					url = TEXT
					url {
						typolink {
							parameter = {$e_magineurs.tx_solr.index.queue.glossaire.pidGlossaireDetail}
							additionalParams = &tx_dpnglossary_glossarydetail%5Bterm%5D={field:uid}&tx_dpnglossary_glossarydetail%5Baction%5D=show&tx_dpnglossary_glossarydetail%5Bcontroller%5D=Term
							additionalParams.insertData = 1
							returnLast = url
							useCacheHash = 1
						}
					}
				}
			}


			fileadmin = 0

			dossier_fichier = 0
			dossier_fichier {
				table = sys_file_storage
				storageUid = 2
			}

			_FILES {
				# Basic configuration which applies to all files which are indexed, record: sys_file_metadata
				default {
					type_stringS = TEXT
					type_stringS.value = Document
					title = title		
					thumbnail_stringM = CONTENT
					thumbnail_stringM {
						table = sys_file_metadata
						select{		
							pidInList = root
							selectFields = sys_file_processedfile.identifier
							join = sys_file_processedfile ON sys_file_metadata.file = sys_file_processedfile.original
							where.data = field:file
							where.wrap = sys_file_processedfile.original=|
							max = 1
						}
						renderObj = TEXT
						renderObj {
							value.field = identifier
							if.isTrue.field = identifier
						}
					}
					extension_textS = SOLR_RELATION
					extension_textS {
						localField = file
						foreignLabelField = extension
					}
					size_textS = COA
					size_textS.10 = SOLR_RELATION
					size_textS.10 {
						localField = file
						foreignLabelField = size
					}
					content = description
				}
			}
		}
	}
	search {
		targetPage = {$e_magineurs.tx_solr.search.targetPage}
		initializeWithEmptyQuery = 1
		showResultsOfInitialEmptyQuery = 1
		query {
			allowEmptyQuery = {$e_magineurs.tx_solr.search.query.allowEmptyQuery}
			// qf parameter http://wiki.apache.org/solr/DisMaxQParserPlugin#qf_.28Query_Fields.29
			queryFields = content^40.0, title^5.0, keywords^2.0, tagsH1^5.0, tagsH2H3^3.0, tagsH4H5H6^2.0, tagsInline^1.0
			// see http://wiki.apache.org/solr/DisMaxRequestHandler#mm_.28Minimum_.27Should.27_Match.29
			minimumMatch = 2<-15%			
		}
        results {
			resultsHighlighting = 1
			resultsHighlighting {
				highlightFields = title, contentun_textS, content
			}
			resultsPerPage = {$e_magineurs.tx_solr.search.results.resultsPerPage}
		}
        sorting = 1
        sorting {
            options {
                relevance.label = Pertinence
                title.label = Titre
                type >
                author >
                created.label = Date de création
            }
        }
        faceting = 1
        faceting {
        	minimumCount = 1
            sortBy = count
            limit = 100
            showEmptyFacets = 0
            keepAllFacetsOnSelection = 0
            
            facets {
                type {
                    field = type_stringS
                    label = Contenu
                }
            }
            
            showAllLink.wrap = <li>|</li>
        }
		lastSearches = 1
		lastSearches {
			mode = user
			limit = 10
		}
		frequentSearches = 1
	}
	statistics = 1
	statistics {
		anonymizeIP = 1
		topHits {
			days = 30
			limit = 5
		}
		noHits {
			days = 30
			limit = 5
		}
		queries {
			days = 30
			limit = 100
		}
	}
}